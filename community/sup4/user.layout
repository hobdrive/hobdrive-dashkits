<?xml version="1.0" encoding="utf-8"?>
<!-- sup4 landscape: 1000 x 560 composition, 0–9000 RPM, 270-degree sweep.
     Fit accounts for the section renderer's 2% right margin.
     Middle side readings follow a radius-310 circle; the radius-360 separators
     run between their labels and values. Values overlay the full composition
     so their boxes can follow the dial beyond the rectangular side columns.
     Zero padding before each crop applies the mask rotation before clipping.
     Portrait below reuses the same dial in a uniformly fitted square. -->
<ui>
<section name="sup4" title-height="0" fixed="true" maximize-focus="true" controls="autohide" ignore-gauges="true" if="LandscapeLayout">
  <config id="Layout_Sup4_Racing" type="bool" default="true" title="Racing readings" descr="Enabled: original racing readings. Disable to show fuel consumption, trip distance, average speed and remaining range." title-ru="Гоночные показатели" descr-ru="Включено: оригинальные гоночные показатели. Выключите для показа расхода топлива, пробега поездки, средней скорости и запаса хода."/>
  <union>
    <item>
      <image image-path="images/sup4/landscape-backdrop-$Theme_brightness.svg" image-aspect="false"/>
    </item>
    <grid rows="${Max(0; 50 - (LayoutWidth * 0.98) / LayoutHeight * 560 / 1000 * 50)},${Min(100; (LayoutWidth * 0.98) / LayoutHeight * 560 / 1000 * 100)},${Max(0; 50 - (LayoutWidth * 0.98) / LayoutHeight * 560 / 1000 * 50)}" cols="${Max(0; 50 - LayoutHeight / (LayoutWidth * 0.98) * 1000 / 560 * 50)},${Min(100; LayoutHeight / (LayoutWidth * 0.98) * 1000 / 560 * 100)},${Max(0; 50 - LayoutHeight / (LayoutWidth * 0.98) * 1000 / 560 * 50)}">
      <item/>
      <item/>
      <item/>
      <item/>
      <union>
        <item if="${Layout_Sup4_Racing}">
          <image image-path="images/sup4/landscape-panel-$Theme_brightness.svg" image-aspect="false"/>
        </item>
        <item if="${!Layout_Sup4_Racing}">
          <image image-path="images/sup4/landscape-panel-daily-$Theme_brightness.svg" image-aspect="false"/>
        </item>
        <grid rows="100" cols="22,56,22">
          <item/>
          <union>
            <item id="RPM" type="text" period="50" description="hidden" units="none" text-values="0:" wrap="smooth(160,40,0)">
              <image image-path="images/sup4/landscape-tach-$Theme_brightness.svg" image-aspect="false"/>
              <break/>
              <image image-path="images/sup4/landscape-cover-left-$Theme_brightness.svg" image-aspect="false"/>
              <filter effect="rotate($${Min(180; Max(0; Sensor_Value * 0.03))},50%,50%)" mode="in" interval="40"/>
              <padding padding="0"/>
              <crop crop="0 50% 0 0"/>
              <break/>
              <image image-path="images/sup4/landscape-cover-right-$Theme_brightness.svg" image-aspect="false"/>
              <filter effect="rotate($${Min(90; Max(0; Sensor_Value * 0.03 - 180))},50%,50%)" mode="in" interval="40"/>
              <padding padding="0"/>
              <crop crop="0 0 50% 50%"/>
              <break/>
              <image image-path="images/sup4/landscape-marks-$Theme_brightness.svg" image-aspect="false"/>
              <break/>
              <image image-path="images/sup4/landscape-needle.svg" image-aspect="false" image-rotate="$${180 + Min(9000; Max(0; Sensor_Value)) * 0.03}" image-rotate-align="center"/>
            </item>
            <item id="RPM" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="78" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="50">
              <padding padding="44% 26% 49.6% 51%"/>
            </item>
            <item id="Speed" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="78" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#95601c&quot; : &quot;#734409&quot;}" period="50">
              <padding padding="56.2% 9% 38.2% 72%"/>
            </item>
            <item id="Speed" type="text" description="hidden" units="aside" size="24" text-outline="false" text-values="0:" colored-value="true" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}">
              <padding padding="64% 9% 32% 69%"/>
            </item>
          </union>
          <item/>
        </grid>
        <union if="${Layout_Sup4_Racing}">
          <item id="FuelPressure" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="1000">
            <padding padding="24.1071% 78.4400% 68.0357% 14.7400%"/>
          </item>
          <item id="IntakeAirTemp" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="5000">
            <padding padding="37.5000% 77.2161% 54.6429% 15.9639%"/>
          </item>
          <item id="BoostPressure" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="1fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="200">
            <padding padding="50.8929% 77.4722% 41.2500% 15.7078%"/>
          </item>
          <item id="ControlModuleVoltage" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="1fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="10000">
            <padding padding="64.2857% 75.8639% 27.8571% 17.3161%"/>
          </item>
          <item id="Lambda" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="3fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="500">
            <padding padding="77.6786% 78.4400% 14.4643% 14.7400%"/>
          </item>
          <item id="EthanolContent" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="10000">
            <padding padding="24.1071% 15.1800% 68.0357% 78.2200%"/>
          </item>
          <item id="CoolantTemp" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="10000">
            <padding padding="37.5000% 16.0739% 54.6429% 77.3261%"/>
          </item>
          <item id="EngineOilTemp" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="5000">
            <padding padding="50.8929% 15.8178% 41.2500% 77.5822%"/>
          </item>
          <item id="OilPressure" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="1fixed" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="500">
            <padding padding="64.2857% 17.4261% 27.8571% 75.9739%"/>
          </item>
          <item id="Odometer" type="text" description="hidden" units="none" text-outline="false" colored-value="true" precision="0fixed" size="44" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" period="120000" actions="SetupOdometer">
            <padding padding="77.6786% 13.8600% 14.4643% 78.2200%"/>
          </item>
        </union>
        <union if="${!Layout_Sup4_Racing}">
          <item id="FuelEconomy_instant" type="text" description="hidden" units="none" text-outline="false" colored-value="true" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" precision="1fixed" period="1000">
            <padding padding="24.4643% 78.4400% 70.0000% 14.7400%"/>
          </item>
          <item id="FuelEconomy_instant" type="text" description="hidden" units="aside" text-outline="false" colored-value="true" size="34" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#b0b8c3&quot; : &quot;#566373&quot;}" text-values="0:" period="1000" text-evaluator="$${svalid(&quot;FuelEconomy_instant&quot;) ? Sensor_Text : &quot;&quot;}" ignore-value-validness="true">
            <padding padding="30.5357% 78.4400% 66.6071% 14.7400%"/>
          </item>
          <item id="DateTime" type="text" description="hidden" units="none" text-outline="false" colored-value="true" size="56" text-align="left" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#e4e7ed&quot; : &quot;#27313f&quot;}" text-evaluator="${t(&quot;sup4.Instant.Title&quot;)}" ignore-value-validness="true" period="10000">
            <padding padding="24.2857% 86.4% 71.0714% 2.4%"/>
          </item>
          <item id="DateTime" type="text" description="hidden" units="none" text-outline="false" colored-value="true" size="38" text-align="left" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#b0b8c3&quot; : &quot;#566373&quot;}" text-evaluator="${t(&quot;sup4.Instant.Detail&quot;)}" ignore-value-validness="true" period="10000">
            <padding padding="29.4643% 86.4% 67.5000% 2.4%"/>
