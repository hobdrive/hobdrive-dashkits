          <item id="FuelEconomy_trip" type="text" description="hidden" units="none" text-outline="false" colored-value="true" size="70" text-align="center" color-map="0:${Theme_brightness = &quot;dark&quot; ? &quot;#ffc64a&quot; : &quot;#925509&quot;}" precision="1fixed" period="2000">
